{
  "manifest_version": 3,
  "name": "图片格式另存为",
  "description": "右键将图片另存为 PNG、JPG 或 WebP 格式",
  "version": "1.0.0",
  "permissions": ["contextMenus", "downloads", "offscreen", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
